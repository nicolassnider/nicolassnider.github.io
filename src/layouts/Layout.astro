---
import '../styles/global.css';
import { AUTHOR_NAME, AUTHOR_EMAIL, AUTHOR_GITHUB, AUTHOR_LINKEDIN } from '../config';
import { ui } from '../data/ui';
import { skills } from '../data/skills';
import type { I18nProps } from '../types';
import AosInit from '../components/AosInit';
import VisitCounter from '../components/VisitCounter';
import ScrollToTop from '../components/ui/ScrollToTop';

type Props = I18nProps;

const { lang } = Astro.props;
const t = ui[lang];
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" href="/favicon.ico?v=2" />
		<meta name="generator" content={Astro.generator} />
		<title>{AUTHOR_NAME} | {t['hero.title']}</title>
		<meta name="description" content={t['hero.description']} />
		<meta name="author" content={AUTHOR_NAME} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={`${AUTHOR_NAME} | ${t['hero.title']}`} />
		<meta property="og:description" content={t['hero.description']} />
		<meta property="og:image" content={new URL('/images/og-image.png', Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={`${AUTHOR_NAME} | ${t['hero.title']}`} />
		<meta property="twitter:description" content={t['hero.description']} />
		<meta property="twitter:image" content={new URL('/images/og-image.png', Astro.url)} />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={Astro.url} />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": AUTHOR_NAME,
			"url": Astro.url,
			"jobTitle": t['hero.title'],
			"image": new URL('/images/avatar.png', Astro.url).toString(),
			"sameAs": [
				AUTHOR_GITHUB,
				AUTHOR_LINKEDIN
			],
			"knowsAbout": skills[lang]
		})} />
	</head>
	<body class="bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 min-h-screen flex flex-col font-sans relative selection:bg-blue-500/30">
		<!-- Accessible Skip to Content Link -->
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-blue-600 focus:text-white focus:font-semibold focus:rounded-lg focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition-all"
		>
			{t['a11y.skipToContent']}
		</a>

		<!-- Ambient Background Gradient for Glassmorphism to pop -->
		<div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
			<div class="absolute -top-[40%] -left-[20%] w-[70%] h-[70%] rounded-full bg-blue-500/10 dark:bg-blue-600/10 blur-3xl"></div>
			<div class="absolute top-[60%] -right-[10%] w-[60%] h-[60%] rounded-full bg-purple-500/10 dark:bg-purple-600/10 blur-3xl"></div>
		</div>

		<slot />

		<!-- Enriched Footer -->
		<footer class="bg-gray-50 dark:bg-gray-950 py-10 border-t border-gray-200 dark:border-gray-800 text-center mt-auto">
			<div class="max-w-5xl mx-auto px-6 space-y-6 text-sm text-gray-500 dark:text-gray-400">
				<!-- Upper row: Info, Stack & Direct Socials -->
				<div class="flex flex-col md:flex-row items-center justify-between gap-4">
					<p class="font-medium text-gray-700 dark:text-gray-300">
						&copy; {new Date().getFullYear()} {AUTHOR_NAME}. {t['footer.rights']}
					</p>

					<p class="text-xs font-semibold text-gray-500 dark:text-gray-400">
						{t['footer.builtWith']}
					</p>

					<!-- Direct Social Links -->
					<div class="flex items-center gap-3">
						<a
							href={`mailto:${AUTHOR_EMAIL}`}
							aria-label="Email"
							class="p-2 rounded-lg bg-gray-100 dark:bg-gray-900 hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
							</svg>
						</a>

						<a
							href={AUTHOR_LINKEDIN}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="LinkedIn"
							class="p-2 rounded-lg bg-gray-100 dark:bg-gray-900 hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
						>
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
								<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
							</svg>
						</a>

						<a
							href={AUTHOR_GITHUB}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="GitHub"
							class="p-2 rounded-lg bg-gray-100 dark:bg-gray-900 hover:text-purple-600 dark:hover:text-purple-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
						>
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
								<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
							</svg>
						</a>

						<a
							href={lang === 'es' ? '/Nicolas_Snider_CV_ES.pdf' : '/Nicolas_Snider_CV_EN.pdf'}
							target="_blank"
							rel="noopener noreferrer"
							download
							aria-label={t['hero.downloadCv']}
							class="p-2 rounded-lg bg-gray-100 dark:bg-gray-900 hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
							</svg>
						</a>
					</div>
				</div>

				<!-- Lower row: Status & Visit counter -->
				<div class="flex flex-wrap items-center justify-center gap-3 pt-4 border-t border-gray-200/50 dark:border-gray-800/50">
					<VisitCounter client:load lang={lang} />
					<p class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 text-xs font-medium text-gray-600 dark:text-gray-400">
						<span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
						{t['footer.lastUpdated']}
					</p>
				</div>
			</div>
		</footer>

		<ScrollToTop client:load lang={lang} />
		<AosInit client:load />
	</body>
</html>
